[sub_resource type="Resource" id="TidalShockEffect"]
script = ExtResource("2_effect")

[resource]
script = ExtResource("1_definition")
id = &"glass_sea_diver_tidal_shock"
display_name = "深蓝明灯"
description = "每路涌出一道从左向右的穿透浪，将碰到的僵尸右推 2 格。每道浪碰到僵尸时触发震颤，间隔至少 0.3 秒。震颤对波及的僵尸施加 4 秒特殊减速和 2 点冻结值。开战时进入冷却。"
icon = ExtResource("5_icon")
cut_in_portrait = ExtResource("3_portrait")
cut_in_title = ExtResource("4_title")
cut_in_accent = Color(0.22, 0.76, 0.89, 1)
cooldown_seconds = 90.0
starts_on_cooldown = true
effect = SubResource("TidalShockEffect")

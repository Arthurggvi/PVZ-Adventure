[resource]
script = ExtResource("1_definition")
id = &"midnight_clockmaker_slow"
display_name = "TMC-112"
description = "使首领和可受控的敌方僵尸行动降至原速的十分之一，在 12 秒内逐渐恢复。期间入场的目标继承当前倍率和剩余时长。"

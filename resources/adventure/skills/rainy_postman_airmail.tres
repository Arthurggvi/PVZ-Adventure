[sub_resource type="Resource" id="AirmailEffect"]
script = ExtResource("2_effect")

[resource]
script = ExtResource("1_definition")
id = &"rainy_postman_airmail"
display_name = "战场速递"
description = "从背包随机派送三张零费的一次性植物卡。同种取最高星，优先抽不同种，继承原转职并升一星（最高十星）；每张卡落地 15 秒未种植即消失。"
icon = SubResource("Icon")
cut_in_portrait = ExtResource("3_portrait")
cut_in_title = ExtResource("4_title")
cut_in_sound = ExtResource("6_cue")
cut_in_accent = Color(0.58, 0.73, 1, 1)
cooldown_seconds = 50.0
starts_on_cooldown = false
effect = SubResource("AirmailEffect")

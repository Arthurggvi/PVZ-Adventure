[sub_resource type="Resource" id="AuroraStarfallEffect"]
script = ExtResource("2_effect")

[resource]
script = ExtResource("1_definition")
id = &"eve_aurora_starfall"
display_name = "极光星弹"
description = "发射六发极光星弹，优先追踪不同敌人并尽量拉开落点。无目标时随机落下。每发触地即凝成星空冰，对落点周围 3×3 格的敌人造成 200 点伤害，施加 5 秒特殊减速，并分别以 50% 概率直接魅惑存活的普通僵尸。开战时进入冷却。"
icon = ExtResource("5_icon")
cut_in_portrait = ExtResource("3_portrait")
cut_in_title = ExtResource("4_title")
cut_in_sound = ExtResource("6_chime")
cut_in_accent = Color(0.36, 0.81, 0.90, 1)
cooldown_seconds = 90.0
starts_on_cooldown = true
effect = SubResource("AuroraStarfallEffect")

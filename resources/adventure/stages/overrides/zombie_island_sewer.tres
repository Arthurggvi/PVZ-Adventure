[resource]
script = ExtResource("1_override")
battle_background_texture = ExtResource("battlebg")
water_surface_profile = ExtResource("water_profile")
terrain_rows_override = Array[int]([1, 0, 0, 0, 1])
daytime_override = 0
daytime_sun_override = 0
normal_wave_profile = SubResource("NormalProfile")
nightmare_wave_profile = SubResource("NightmareProfile")
replace_nightmare_bosses = true
normal_battle_music = ExtResource("normal_music")
nightmare_battle_music = ExtResource("nightmare_music")

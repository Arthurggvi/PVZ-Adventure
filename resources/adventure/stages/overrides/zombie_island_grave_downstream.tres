[resource]
script = ExtResource("1_override")
battle_background_texture = ExtResource("battlebg")
daytime_override = 0
daytime_sun_override = 0
normal_gravestone_rules = SubResource("NaturalGravestones")
nightmare_gravestone_rules = SubResource("NaturalGravestones")
normal_wave_profile = SubResource("NormalProfile")
nightmare_wave_profile = SubResource("NightmareProfile")
additional_normal_events = Array[ExtResource("6_event")]([SubResource("NormalStartGraves")])
additional_nightmare_events = Array[ExtResource("6_event")]([SubResource("NightmareStartGraves"), SubResource("NightmareWave30Graves"), SubResource("NightmareWave40Graves")])
replace_nightmare_bosses = true
nightmare_bosses = Array[ExtResource("7_boss")]([SubResource("NightmareWhiteDuke")])
normal_battle_music = ExtResource("3_music_normal")
nightmare_battle_music = ExtResource("4_music_nightmare")
nightmare_boss_music = ExtResource("5_music_boss")
weather_lens_profile = ExtResource("lens_profile")
nightmare_weather_sequence = ExtResource("weather_storm")

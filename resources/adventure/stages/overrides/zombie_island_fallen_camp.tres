[gd_resource type="Resource" script_class="AdventureStageOverride" format=3]

[ext_resource type="Script" path="res://scripts/adventure/adventure_stage_override.gd" id="1_override"]
[ext_resource type="Script" path="res://scripts/adventure/stages/wave_band_definition.gd" id="2_band"]
[ext_resource type="Script" path="res://scripts/adventure/stages/wave_profile.gd" id="3_profile"]
[ext_resource type="Script" path="res://scripts/adventure/stages/wave_spawn_group.gd" id="4_spawn"]

[ext_resource type="Texture2D" path="res://assets/adventure/environments/battle_backgrounds/02_fallen_camp_day.jpg" id="battlebg_camp"]

[sub_resource type="Resource" id="NormalOpening"]
script = ExtResource("2_band")
band_id = &"zombie_island.fallen_camp.normal.opening"
first_wave = 1
last_wave = 10
zombie_weights = Dictionary[int, int]({
1: 6,
3: 3,
5: 2
})
tier_weights = Dictionary[StringName, int]({
&"base": 1
})


[sub_resource type="Resource" id="NormalProfile"]
script = ExtResource("3_profile")
profile_id = &"zombie_island.fallen_camp.normal.waves"
wave_count = 30
flag_waves = Array[int]([10, 20])
scheduled_spawns = Array[ExtResource("4_spawn")]([SubResource("NormalFirstFlagPoles"), SubResource("NormalSecondFlagCones"), SubResource("NormalThirdFlagBuckets")])
bands = Array[ExtResource("2_band")]([SubResource("NormalOpening"), SubResource("NormalPolePool"), SubResource("NormalVeteranPool")])


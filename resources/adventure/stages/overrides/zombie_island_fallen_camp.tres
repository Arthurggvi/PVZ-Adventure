[gd_resource type="Resource" script_class="AdventureStageOverride" format=3]

[ext_resource type="Script" path="res://scripts/adventure/adventure_stage_override.gd" id="Override"]
[ext_resource type="Script" path="res://scripts/adventure/stages/stage_event_definition.gd" id="Event"]
[ext_resource type="Script" path="res://scripts/adventure/stages/drop_table.gd" id="Table"]
[ext_resource type="Script" path="res://scripts/adventure/stages/drop_entry_definition.gd" id="Entry"]
[ext_resource type="Resource" path="res://resources/weather/fallen_camp_normal_weather.tres" id="weather_normal"]
[ext_resource type="Resource" path="res://resources/weather/fallen_camp_nightmare_weather.tres" id="weather_nightmare"]
[ext_resource type="AudioStream" path="res://resources/adventure/audio/fallen_camp_normal.mp3" id="music_normal"]
[ext_resource type="AudioStream" path="res://resources/adventure/audio/fallen_camp_nightmare.mp3" id="music_nightmare"]
[ext_resource type="AudioStream" path="res://resources/adventure/audio/fallen_camp_boss.mp3" id="music_boss"]

[sub_resource type="Resource" id="edgar_key_upper"]
script = ExtResource("Entry")
entry_id = &"zombie_island.fallen_camp.boss.drops.edgar_key_upper"
rule = 3
asset_kind = 2
asset_id = &"zombie_island.edgar_temple.nightmare_key"
quantity_min = 1
quantity_max = 1

[sub_resource type="Resource" id="EdgarKeyDrops"]
script = ExtResource("Table")
table_id = &"zombie_island.fallen_camp.boss.edgar_key_drops"
entries = Array[ExtResource("Entry")]([SubResource("edgar_key_upper")])

[sub_resource type="Resource" id="BlackGeneralEdgarKey"]
script = ExtResource("Event")
event_id = &"zombie_island.fallen_camp.nightmare.black_general.edgar_key_drop"
trigger = 9
order = 1
repeat_rule = 1
encounter_id = &"zombie_island.fallen_camp.nightmare.black_general"
boss_exit_reason = 2
action = 5
action_drop_table = SubResource("EdgarKeyDrops")

[resource]
script = ExtResource("Override")
normal_weather_sequence = ExtResource("weather_normal")
nightmare_weather_sequence = ExtResource("weather_nightmare")
normal_battle_music = ExtResource("music_normal")
nightmare_battle_music = ExtResource("music_nightmare")
nightmare_boss_music = ExtResource("music_boss")
additional_nightmare_events = Array[ExtResource("Event")]([SubResource("BlackGeneralEdgarKey")])

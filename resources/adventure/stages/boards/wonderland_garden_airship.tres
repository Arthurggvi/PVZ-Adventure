surfaces = Array[ExtResource("surface")]([SubResource("UpperPort"), SubResource("LowerPort"), SubResource("UpperCenter"), SubResource("LowerCenter"), SubResource("UpperStarboard"), SubResource("LowerStarboard"), SubResource("UpperBow"), SubResource("LowerBow"), SubResource("FixedBridge")])

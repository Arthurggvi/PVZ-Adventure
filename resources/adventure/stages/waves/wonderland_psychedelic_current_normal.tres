[gd_resource type="Resource" script_class="WaveProfile" format=3]

[ext_resource type="Script" path="res://scripts/adventure/stages/wave_profile.gd" id="profile"]
[ext_resource type="Script" path="res://scripts/adventure/stages/wave_band_definition.gd" id="band"]
[ext_resource type="Script" path="res://scripts/adventure/stages/wave_spawn_group.gd" id="spawn"]

[sub_resource type="Resource" id="Opening"]
script = ExtResource("band")
band_id = &"wonderland.psychedelic_current.normal.opening"
first_wave = 1
last_wave = 10
minimum_regular_power = 8
zombie_weights = Dictionary[int, int]({3: 3, 11: 6, 12: 2})
tier_weights = Dictionary[StringName, int]({&"veteran": 1})


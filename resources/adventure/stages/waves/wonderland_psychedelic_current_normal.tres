[resource]
script = ExtResource("profile")
profile_id = &"wonderland.psychedelic_current.normal.waves"
wave_count = 40
flag_waves = Array[int]([10, 20, 30])
scheduled_spawns = Array[ExtResource("spawn")]([
SubResource("Flag10"), SubResource("FirstFlagDoors"),
SubResource("Flag20"), SubResource("SecondFlagDolphins"),
SubResource("Flag30"), SubResource("ThirdFlagBuckets"),
SubResource("Flag40")
])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Doors"), SubResource("Dolphins"), SubResource("Buckets"), SubResource("Late"), SubResource("Final")])

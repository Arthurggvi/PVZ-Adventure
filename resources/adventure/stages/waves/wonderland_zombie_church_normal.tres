[resource]
script = ExtResource("profile")
profile_id = &"wonderland.zombie_church.normal.waves"
wave_count = 70
max_zombies_per_wave = 30
wave_interval_multiplier = 0.8
flag_waves = Array[int]([70])
scheduled_spawns = Array[ExtResource("spawn")]([
SubResource("Fusion10"), SubResource("Fusion20"), SubResource("Fusion30"), SubResource("Fusion40"), SubResource("Fusion50"),
SubResource("Fusion60"), SubResource("Fusion70")
])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Surge"), SubResource("Middle"), SubResource("Late")])

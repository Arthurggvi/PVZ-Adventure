[sub_resource type="Resource" id="Opening"]
script = ExtResource("band")
band_id = &"wonderland.zombie_church.normal.opening"
first_wave = 1
last_wave = 3
minimum_regular_power = 22
zombie_weights = Dictionary[int, int]({1: 1})
tier_weights = Dictionary[StringName, int]({&"elite": 4, &"tier4": 1})


[resource]
script = ExtResource("profile")
profile_id = &"wonderland.psychedelic_current.nightmare.waves"
wave_count = 50
flag_waves = Array[int]([10, 20, 30, 40])
scheduled_spawns = Array[ExtResource("spawn")]([
SubResource("Flag10"), SubResource("PapersRow1"), SubResource("PapersRow2"), SubResource("PapersRow3"), SubResource("PapersRow4"), SubResource("PapersRow5"),
SubResource("Flag20"), SubResource("DoorsRow1"), SubResource("DoorsRow2"), SubResource("DoorsRow3"), SubResource("DoorsRow4"), SubResource("DoorsRow5"),
SubResource("Flag30"), SubResource("BucketsRow1"), SubResource("BucketsRow2"), SubResource("BucketsRow3"), SubResource("BucketsRow4"), SubResource("BucketsRow5"),
SubResource("Flag40"), SubResource("FootballRow1"), SubResource("FootballRow2"), SubResource("FootballRow3"), SubResource("FootballRow4"), SubResource("FootballRow5"),
SubResource("Flag50")
])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Second"), SubResource("Third"), SubResource("Fourth"), SubResource("Late"), SubResource("Final")])

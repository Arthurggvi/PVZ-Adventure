[resource]
script = ExtResource("profile")
profile_id = &"wonderland.snow_mountains.normal.waves"
wave_count = 50
flag_waves = Array[int]([10, 20, 30, 40])
max_zombies_per_wave = 72
wave_interval_multiplier = 0.95
spawn_count_multiplier = 0.5
late_spawn_count_start_wave = 30
late_spawn_count_multiplier = 0.5
bonus_zombie_type = 33
bonus_first_wave_count = 1
bonus_final_wave_count = 12
bonus_live_cap = 12
scheduled_spawns = Array[ExtResource("spawn")]([SubResource("NormalWaveFlag10Zombie"), SubResource("NormalWaveFlag20Zombie"), SubResource("NormalWaveFlag30Zombie"), SubResource("NormalWaveFlag40Zombie"), SubResource("NormalWaveFlag50Zombie"), SubResource("NormalFlag10Row1Type32"), SubResource("NormalFlag10Row2Type32"), SubResource("NormalFlag10Row3Type32"), SubResource("NormalFlag10Row4Type32"), SubResource("NormalFlag10Row5Type32"), SubResource("NormalFlag10Row6Type32"), SubResource("NormalFlag20Row1Type13"), SubResource("NormalFlag20Row2Type13"), SubResource("NormalFlag20Row3Type13"), SubResource("NormalFlag20Row4Type13"), SubResource("NormalFlag20Row5Type13"), SubResource("NormalFlag20Row6Type13"), SubResource("NormalFlag30Row1Type30"), SubResource("NormalFlag30Row2Type30"), SubResource("NormalFlag30Row3Type30"), SubResource("NormalFlag30Row4Type30"), SubResource("NormalFlag30Row5Type30"), SubResource("NormalFlag30Row6Type30"), SubResource("NormalFlag40Row1Type30"), SubResource("NormalFlag40Row1Type32"), SubResource("NormalFlag40Row2Type30"), SubResource("NormalFlag40Row2Type32"), SubResource("NormalFlag40Row3Type30"), SubResource("NormalFlag40Row3Type32"), SubResource("NormalFlag40Row4Type30"), SubResource("NormalFlag40Row4Type32"), SubResource("NormalFlag40Row5Type30"), SubResource("NormalFlag40Row5Type32"), SubResource("NormalFlag40Row6Type30"), SubResource("NormalFlag40Row6Type32"), SubResource("NormalFinalSurge")])

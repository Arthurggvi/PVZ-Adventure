[resource]
script = ExtResource("profile")
profile_id = &"wonderland.zombie_church.nightmare.waves"
wave_count = 100
max_zombies_per_wave = 30
wave_interval_multiplier = 0.8
flag_waves = Array[int]([100])
scheduled_spawns = Array[ExtResource("spawn")]([
SubResource("Fusion5"), SubResource("Fusion10"), SubResource("Fusion15"), SubResource("Fusion20"), SubResource("Fusion25"),
SubResource("Fusion30"), SubResource("Fusion35"), SubResource("Fusion40"), SubResource("Fusion45"), SubResource("Fusion50"),
SubResource("Fusion55"), SubResource("Fusion60"), SubResource("Fusion65"), SubResource("Fusion70"), SubResource("Fusion75"),
SubResource("Fusion80"), SubResource("Fusion85"), SubResource("Fusion90"), SubResource("Fusion95"), SubResource("Fusion100")
])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Surge"), SubResource("Middle"), SubResource("Heavy"), SubResource("Late")])

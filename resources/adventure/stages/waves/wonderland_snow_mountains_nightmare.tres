wave_interval_multiplier = 0.9
spawn_count_multiplier = 0.7
late_spawn_count_start_wave = 30
late_spawn_count_multiplier = 0.5
prefer_high_threat_spawns = true
bonus_zombie_type = 33
bonus_first_wave_count = 1
bonus_final_wave_count = 12
bonus_live_cap = 12
scheduled_spawns = Array[ExtResource("spawn")]([SubResource("NightmareWaveFlag10Zombie"), SubResource("NightmareWaveFlag20Zombie"), SubResource("NightmareWaveFlag30Zombie"), SubResource("NightmareWaveFlag40Zombie"), SubResource("NightmareWaveFlag50Zombie"), SubResource("NightmareFlag10Row1Type32"), SubResource("NightmareFlag10Row2Type32"), SubResource("NightmareFlag10Row3Type32"), SubResource("NightmareFlag10Row4Type32"), SubResource("NightmareFlag10Row5Type32"), SubResource("NightmareFlag10Row6Type32"), SubResource("NightmareFlag20Row1Type13"), SubResource("NightmareFlag20Row2Type13"), SubResource("NightmareFlag20Row3Type13"), SubResource("NightmareFlag20Row4Type13"), SubResource("NightmareFlag20Row5Type13"), SubResource("NightmareFlag20Row6Type13"), SubResource("NightmareFlag30Row1Type30"), SubResource("NightmareFlag30Row2Type30"), SubResource("NightmareFlag30Row3Type30"), SubResource("NightmareFlag30Row4Type30"), SubResource("NightmareFlag30Row5Type30"), SubResource("NightmareFlag30Row6Type30"), SubResource("NightmareFlag40Row1Type30"), SubResource("NightmareFlag40Row1Type32"), SubResource("NightmareFlag40Row2Type30"), SubResource("NightmareFlag40Row2Type32"), SubResource("NightmareFlag40Row3Type30"), SubResource("NightmareFlag40Row3Type32"), SubResource("NightmareFlag40Row4Type30"), SubResource("NightmareFlag40Row4Type32"), SubResource("NightmareFlag40Row5Type30"), SubResource("NightmareFlag40Row5Type32"), SubResource("NightmareFlag40Row6Type30"), SubResource("NightmareFlag40Row6Type32"), SubResource("NightmareFinalSurge")])

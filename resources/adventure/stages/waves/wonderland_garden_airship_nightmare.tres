[resource]
script = ExtResource("profile")
profile_id = &"wonderland.garden_airship.nightmare.waves"
wave_count = 50
max_zombies_per_wave = 26
use_classic_spawn_timing = true
classic_opening_protection = false
flag_waves = Array[int]([10, 20, 30, 40])
scheduled_spawns = Array[ExtResource("spawn")]([SubResource("Flag10"), SubResource("FirstNewspapers"), SubResource("Flag20"), SubResource("Flag30"), SubResource("TransportAirship"), SubResource("FirstFootball"), SubResource("Flag40"), SubResource("Flag50")])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Newspapers"), SubResource("Football")])

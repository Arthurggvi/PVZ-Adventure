[ext_resource type="Script" path="res://scripts/adventure/stages/wave_spawn_group.gd" id="spawn"]

[sub_resource type="Resource" id="Opening"]
script = ExtResource("band")
band_id = &"wonderland.garden_airship.nightmare.opening"
first_wave = 1
last_wave = 10
minimum_regular_power = 10
zombie_weights = Dictionary[int, int]({1: 6, 3: 3, 4: 2, 5: 1})
tier_weights = Dictionary[StringName, int]({&"veteran": 3, &"elite": 1})


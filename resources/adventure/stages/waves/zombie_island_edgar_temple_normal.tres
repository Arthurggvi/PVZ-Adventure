[resource]
script = ExtResource("profile")
profile_id = &"zombie_island.edgar_temple.normal.waves"
wave_count = 50
use_classic_spawn_timing = true
classic_opening_seconds = 35.0
wave_interval_multiplier = 1.5
spawn_count_multiplier = 0.7
opening_spawn_count_multiplier = 0.5
flag_waves = Array[int]([10, 20, 30, 40])
scheduled_spawns = Array[ExtResource("spawn")]([SubResource("Flag10"), SubResource("FirstFlagDoors"), SubResource("FirstFlagBuckets"), SubResource("Flag20"), SubResource("SecondFlagPoles"), SubResource("SecondFlagPapers"), SubResource("Flag30"), SubResource("ThirdFlagFootballRow1"), SubResource("ThirdFlagFootballRow2"), SubResource("ThirdFlagFootballRow3"), SubResource("ThirdFlagFootballRow4"), SubResource("ThirdFlagFootballRow5"), SubResource("ThirdFlagJacksonRow2"), SubResource("ThirdFlagJacksonRow4"), SubResource("Flag40"), SubResource("FourthFlagGargantuarRow1"), SubResource("FourthFlagGargantuarRow3"), SubResource("FourthFlagGargantuarRow5"), SubResource("Flag50"), SubResource("FinalFlagGargantuarRow1"), SubResource("FinalFlagGargantuarRow2"), SubResource("FinalFlagGargantuarRow3"), SubResource("FinalFlagGargantuarRow4"), SubResource("FinalFlagGargantuarRow5")])
bands = Array[ExtResource("band")]([SubResource("Opening"), SubResource("Armor"), SubResource("PoleAndPaper"), SubResource("FootballAndJackson"), SubResource("Late"), SubResource("Final")])

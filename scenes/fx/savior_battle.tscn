[sub_resource type="QuadMesh" id="LightQuad"]
size = Vector2(2, 2)

[sub_resource type="MultiMesh" id="SaviorAirInstances"]
resource_local_to_scene = true
use_colors = true
use_custom_data = true
mesh = SubResource("LightQuad")

[sub_resource type="MultiMesh" id="GospelInstances"]
resource_local_to_scene = true
use_colors = true
use_custom_data = true
mesh = SubResource("LightQuad")

[node name="SaviorBattle" type="CanvasLayer"]
process_mode = 1
process_priority = 19
process_physics_priority = -10
layer = 40
script = ExtResource("battle")

[node name="Ground" type="CanvasLayer" parent="."]
layer = -9
follow_viewport_enabled = true

[node name="SaviorAir" type="MultiMeshInstance2D" parent="Ground"]
material = SubResource("SaviorAir")

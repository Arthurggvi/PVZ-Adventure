[sub_resource type="ShaderMaterial" id="SaviorAfterimage"]
resource_local_to_scene = true
shader = ExtResource("savior_afterimage")

[sub_resource type="ShaderMaterial" id="SaviorAir"]
shader = ExtResource("savior_air")

[sub_resource type="ShaderMaterial" id="GospelPillars"]
